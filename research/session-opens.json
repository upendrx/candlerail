          "long": {
            "all": [
              {
                "left": "low",
                "op": "<",
                "right": "ph.prev_low"
              },
              {
                "left": "close",
                "op": ">",
                "right": "ph.prev_low"
              },
              {
                "left": "lower_wick",
                "op": ">=",
                "right": "0.4 * range"
              },
              {
                "left": "or.minutes",
                "op": ">=",
                "right": "{{window.min}}"
              },
              {
                "left": "or.minutes",
                "op": "<=",
                "right": "{{window.max}}"
              },
              "{{trend.long}}"
            ]
          },
          "short": {
            "all": [
              {
                "left": "high",
                "op": ">",
                "right": "ph.prev_high"
              },
              {
                "left": "close",
                "op": "<",
                "right": "ph.prev_high"
              },
              {
                "left": "upper_wick",
                "op": ">=",
                "right": "0.4 * range"
              },
              {
                "left": "or.minutes",
                "op": ">=",
                "right": "{{window.min}}"
              },
              {
                "left": "or.minutes",
                "op": "<=",
                "right": "{{window.max}}"
              },
              "{{trend.short}}"
            ]
          }
        },
        "exit": {
          "stop_loss": "{{stop.v}}",
          "take_profit": {
            "risk_multiple": "{{rr}}"
          },
          "max_bars": "{{hours:4}}"
        },
        "sizing": {
          "type": "risk_percent",
          "value": 1
        },
        "leverage": 10,
        "risk": {
          "daily_loss_percent": 3,
          "pause_after_losses": 4,
          "pause_bars": "{{hours:1}}"
        }
      }
    }
  ]
