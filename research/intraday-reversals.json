        "sizing": {
          "type": "risk_percent",
          "value": 1
        },
        "leverage": 10,
        "risk": {
          "daily_loss_percent": 3,
          "pause_after_losses": 4,
          "pause_bars": "{{hours:1}}"
        }
      }
    },
