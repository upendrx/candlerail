            "type": "ema",
            "period": "{{hours:8}}"
          }
        },
        "entry": {
          "long": {
            "all": [
              {
                "left": "pa.inside_bar[1]",
                "op": "==",
                "right": 1
              },
              {
                "left": "close",
                "op": ">",
                "right": "high[1]"
              },
              {
                "left": "range",
                "op": ">=",
                "right": "1.5 * range[1]"
              },
              {
                "left": "close",
                "op": ">",
                "right": "open"
              },
              "{{trend.long}}"
            ]
          },
          "short": {
            "all": [
              {
                "left": "pa.inside_bar[1]",
                "op": "==",
                "right": 1
              },
              {
                "left": "close",
                "op": "<",
                "right": "low[1]"
              },
              {
                "left": "range",
                "op": ">=",
                "right": "1.5 * range[1]"
              },
              {
                "left": "close",
                "op": "<",
                "right": "open"
              },
              "{{trend.short}}"
            ]
          }
        },
        "exit": {
          "stop_loss": "{{stop.v}}",
          "take_profit": {
            "risk_multiple": "{{rr}}"
