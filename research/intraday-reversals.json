              {
                "any": [
                  {
                    "left": "pa.bullish_engulfing",
                    "op": "==",
                    "right": 1
                  },
                  {
                    "left": "pa.hammer",
                    "op": "==",
                    "right": 1
                  }
                ]
              },
              "{{trend.long}}"
            ]
          },
          "short": {
            "all": [
              {
                "left": "high",
                "op": ">",
                "right": "vw + 2 * atr"
              },
              {
                "any": [
                  {
                    "left": "pa.bearish_engulfing",
                    "op": "==",
                    "right": 1
                  },
                  {
                    "left": "pa.shooting_star",
                    "op": "==",
                    "right": 1
                  }
                ]
              },
              "{{trend.short}}"
            ]
          }
