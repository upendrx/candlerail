{
  "name": "Intraday reversals on major coins",
  "description": "Fifteen well-known intraday setups, mostly reversals from candle shapes at support and resistance, tested long and short on BTC, ETH, SOL and XRP at 1, 5 and 15 minutes. Each variant is selected on the first 60 days and judged on the last 30, under two cost scenarios, risking 1% of the account per trade with a 3% daily loss limit.",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT",
    "SOLUSDT",
    "XRPUSDT"
  ],
  "intervals": [
    "1m",
    "5m",
    "15m"
  ],
  "days": 90,
  "split": 0.6667,
  "capital": 10000,
  "costs": [
    {
      "label": "futures taker",
      "fee_bps": 5,
      "slippage_bps": 1
    },
    {
      "label": "spot taker",
      "fee_bps": 10,
      "slippage_bps": 2
    }
  ],
  "selection": {
    "min_trades_per_day": 1,
    "max_trades_per_day": 12,
    "min_avg_r": 0.05,
    "min_markets": 3
  },
  "grid": {
    "rr": [
      1,
      1.5,
      2
    ],
    "stop": [
      {
        "label": "beyond the signal candle",
        "v": {
          "below": "low - 0.1 * range",
          "above": "high + 0.1 * range"
        }
      },
      {
        "label": "1 ATR",
        "v": {
          "atr": 1,
          "indicator": "atr"
        }
      },
      {
        "label": "1.5 ATR",
        "v": {
          "atr": 1.5,
          "indicator": "atr"
        }
      },
      {
        "label": "0.3%",
        "v": {
          "percent": 0.3
        }
      },
      {
        "label": "0.6%",
        "v": {
          "percent": 0.6
        }
      }
    ],
    "trend": [
      {
        "label": "any",
        "long": {
          "left": "close",
          "op": ">",
          "right": 0
        },
        "short": {
          "left": "close",
          "op": ">",
          "right": 0
        }
      },
      {
        "label": "with the 8h trend",
        "long": {
          "left": "close",
          "op": ">",
          "right": "trend"
        },
        "short": {
          "left": "close",
          "op": "<",
          "right": "trend"
        }
      }
    ]
  },
  "families": [
    {
      "id": "engulf-level",
      "name": "Engulfing at swing level",
      "idea": "An engulfing candle that forms at the latest swing low (for longs) or swing high (for shorts), within half an ATR of it.",
      "kind": "reversal",
      "strategy": {
        "name": "Engulfing at swing level",
        "indicators": {
          "sw": {
            "type": "swings",
            "left": 5,
            "right": 2
          },
          "pa": {
            "type": "patterns"
          },
          "atr": {
            "type": "atr",
            "period": 14
          },
          "trend": {
            "type": "ema",
            "period": "{{hours:8}}"
          }
        },
        "entry": {
          "long": {
            "all": [
              {
                "left": "pa.bullish_engulfing",
                "op": "==",
                "right": 1
              },
              {
                "left": "low",
                "op": "<=",
                "right": "sw.support + 0.5 * atr"
              },
              {
                "left": "low",
                "op": ">=",
                "right": "sw.support - 1 * atr"
              },
              "{{trend.long}}"
            ]
          },
          "short": {
            "all": [
              {
                "left": "pa.bearish_engulfing",
                "op": "==",
                "right": 1
              },
              {
                "left": "high",
                "op": ">=",
                "right": "sw.resistance - 0.5 * atr"
              },
              {
                "left": "high",
                "op": "<=",
                "right": "sw.resistance + 1 * atr"
              },
              "{{trend.short}}"
            ]
          }
        },
        "exit": {
          "stop_loss": "{{stop.v}}",
          "take_profit": {
            "risk_multiple": "{{rr}}"
          },
          "max_bars": "{{hours:4}}"
        },
        "sizing": {
          "type": "risk_percent",
          "value": 1
        },
        "leverage": 10,
        "risk": {
          "daily_loss_percent": 3,
          "pause_after_losses": 4,
          "pause_bars": "{{hours:1}}"
        }
      }
    },
    {
      "id": "pin-level",
      "name": "Pin bar at swing level",
      "idea": "A hammer that holds the latest swing low, or a shooting star that holds the latest swing high.",
      "kind": "reversal",
      "strategy": {
        "name": "Pin bar at swing level",
        "indicators": {
          "sw": {
            "type": "swings",
            "left": 5,
            "right": 2
          },
          "pa": {
            "type": "patterns"
          },
          "atr": {
            "type": "atr",
            "period": 14
          },
          "trend": {
            "type": "ema",
            "period": "{{hours:8}}"
          }
        },
        "entry": {
          "long": {
            "all": [
              {
                "left": "pa.hammer",
                "op": "==",
                "right": 1
              },
              {
                "left": "low",
                "op": "<=",
                "right": "sw.support + 0.3 * atr"
              },
              {
                "left": "close",
                "op": ">",
                "right": "sw.support"
              },
              "{{trend.long}}"
            ]
          },
          "short": {
            "all": [
              {
                "left": "pa.shooting_star",
                "op": "==",
                "right": 1
              },
              {
                "left": "high",
                "op": ">=",
                "right": "sw.resistance - 0.3 * atr"
              },
              {
                "left": "close",
                "op": "<",
                "right": "sw.resistance"
              },
              "{{trend.short}}"
            ]
          }
        },
        "exit": {
          "stop_loss": "{{stop.v}}",
          "take_profit": {
            "risk_multiple": "{{rr}}"
          },
          "max_bars": "{{hours:4}}"
        },
        "sizing": {
          "type": "risk_percent",
          "value": 1
        },
        "leverage": 10,
        "risk": {
          "daily_loss_percent": 3,
          "pause_after_losses": 4,
          "pause_bars": "{{hours:1}}"
        }
      }
    },
    {
      "id": "sweep-reclaim",
      "name": "Liquidity sweep and reclaim",
      "idea": "Price runs the stops below the last swing low, then closes back above it with a long lower wick (a false breakout). Mirrored for shorts.",
      "kind": "reversal",
      "strategy": {
        "name": "Liquidity sweep and reclaim",
        "indicators": {
          "sw": {
            "type": "swings",
            "left": 5,
            "right": 2
          },
          "atr": {
            "type": "atr",
            "period": 14
          },
          "trend": {
            "type": "ema",
            "period": "{{hours:8}}"
          }
        },
        "entry": {
          "long": {
            "all": [
              {
                "left": "low",
                "op": "<",
                "right": "sw.support"
              },
              {
                "left": "close",
                "op": ">",
                "right": "sw.support"
              },
              {
                "left": "lower_wick",
                "op": ">=",
                "right": "0.4 * range"
              },
              "{{trend.long}}"
            ]
          },
          "short": {
            "all": [
              {
                "left": "high",
                "op": ">",
                "right": "sw.resistance"
              },
              {
                "left": "close",
                "op": "<",
                "right": "sw.resistance"
              },
              {
                "left": "upper_wick",
                "op": ">=",
                "right": "0.4 * range"
              },
              "{{trend.short}}"
            ]
          }
        },
        "exit": {
          "stop_loss": "{{stop.v}}",
          "take_profit": {
            "risk_multiple": "{{rr}}"
          },
          "max_bars": "{{hours:4}}"
        },
        "sizing": {
          "type": "risk_percent",
          "value": 1
        },
        "leverage": 10,
        "risk": {
          "daily_loss_percent": 3,
          "pause_after_losses": 4,
          "pause_bars": "{{hours:1}}"
        }
      }
    },
    {
      "id": "inside-break",
      "name": "Small candle, then big breakout candle",
      "idea": "An inside bar followed by a candle at least 1.5 times its range that closes beyond it.",
      "kind": "breakout",
      "strategy": {
        "name": "Small candle, then big breakout candle",
        "indicators": {
          "pa": {
            "type": "patterns"
          },
          "atr": {
            "type": "atr",
            "period": 14
          },
