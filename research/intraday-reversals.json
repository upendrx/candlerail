          },
          "trend": {
            "type": "ema",
            "period": "{{hours:8}}"
          }
        },
        "entry": {
          "long": {
            "all": [
              {
                "left": "low",
                "op": "<",
                "right": "bb.lower"
              },
              {
                "left": "close",
                "op": ">",
                "right": "bb.lower"
              },
              {
                "left": "close",
                "op": ">",
                "right": "open"
              },
              {
                "left": "lower_wick",
                "op": ">=",
                "right": "0.3 * range"
              },
              "{{trend.long}}"
            ]
          },
