{
  "name": "Swing and trend strategies for monthly profit",
  "description": "Eleven well-known swing and trend-following strategies, long-only (spot) or long and short (futures), on ten major Binance coins at 1 hour, 4 hours and 1 day. Each variant is chosen on the first two years and judged on the last year, risking 2% of the account per trade without leverage, and compared month by month with buying and holding the same coins.",
  "symbols": [
    "BTCUSDT",
    "ETHUSDT",
    "SOLUSDT",
    "XRPUSDT",
    "BNBUSDT",
    "DOGEUSDT",
    "ADAUSDT",
    "AVAXUSDT",
    "LINKUSDT",
    "LTCUSDT"
  ],
  "intervals": [
    "1h",
    "4h",
    "1d"
  ],
  "days": 1095,
  "split": 0.6667,
  "capital": 10000,
  "costs": [
    {
      "label": "spot taker",
      "fee_bps": 10,
      "slippage_bps": 2
    },
    {
      "label": "futures taker",
      "fee_bps": 5,
      "slippage_bps": 1
    }
  ],
  "selection": {
    "portfolio": true,
    "min_trades_per_day": 0.3,
    "max_trades_per_day": 40,
    "min_avg_r": 0.05,
    "min_markets": 6
  },
  "families": [
    {
      "id": "donchian",
      "name": "Donchian channel breakout",
      "idea": "The Turtle rules: buy a close above the highest high of the last N candles, sell when price closes below the low of a shorter channel. Mirrored for shorts.",
      "kind": "trend",
      "grid": {
        "side": [
          {
            "label": "long only",
            "entry": null,
            "exit": null
          },
          {
            "label": "long and short",
            "entry": {
              "left": "close",
              "op": "<",
              "right": "dc_in.lower[1]"
            },
            "exit": {
              "left": "close",
              "op": ">",
              "right": "dc_out.upper[1]"
            }
          }
        ],
        "stop": [
          {
            "label": "2 ATR",
            "v": {
              "atr": 2,
              "indicator": "atr"
            }
          },
          {
            "label": "3 ATR",
            "v": {
              "atr": 3,
              "indicator": "atr"
            }
          }
        ],
        "trail": [
          {
            "label": "none",
            "v": null
          },
          {
            "label": "3 ATR trailing",
            "v": {
              "atr": 3,
              "indicator": "atr"
            }
          }
        ],
        "ch": [
          {
            "label": "20/10",
            "in": 20,
            "out": 10
          },
          {
            "label": "55/20",
            "in": 55,
            "out": 20
          }
        ]
      },
      "strategy": {
        "name": "Donchian channel breakout",
        "indicators": {
          "dc_in": {
            "type": "donchian",
            "period": "{{ch.in}}"
          },
          "dc_out": {
            "type": "donchian",
            "period": "{{ch.out}}"
          },
          "atr": {
            "type": "atr",
            "period": 14
          }
        },
        "entry": {
          "long": {
            "left": "close",
            "op": ">",
            "right": "dc_in.upper[1]"
          },
          "short": "{{side.entry}}"
        },
        "exit": {
          "long": {
            "left": "close",
            "op": "<",
            "right": "dc_out.lower[1]"
          },
          "short": "{{side.exit}}",
          "stop_loss": "{{stop.v}}",
          "trailing_stop": "{{trail.v}}"
        },
        "sizing": {
          "type": "risk_percent",
          "value": 2
        },
        "leverage": 1
      }
    },
    {
